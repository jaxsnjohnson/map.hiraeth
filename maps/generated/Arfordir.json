        {
          "id": "region-shrine-to-all",
          "name": "Shrine To All",
          "description": "Rather than a single temple, this sacred space is an open-air collection of small, hand-built shrines nestled within the crumbling stone walls of an ancient ruin. Each alcove is dedicated to a different deity, reflecting the diverse faiths of the settlers who came seeking a new life. Offerings of wildflowers, carved wooden figures, and coins are left by the hopeful. The shrine is quietly maintained by an elderly woman named Lena, who ensures that all gods, great and small, are shown their due respect.",
          "type": "Temple",
          "color": "#fffb00",
